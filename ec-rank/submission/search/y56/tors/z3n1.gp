z3n1secs=[-34*t^3 + 510*t^2 - 1904*t + 2040, 34*t^3 + 510*t^2 + 1904*t + 2040, -t^4 + 109*t^2 - 900, -34/25*t^4 + 34/25*t^3 + 3604/25*t^2 - 136*t - 816, -34/25*t^4 - 34/25*t^3 + 3604/25*t^2 + 136*t - 816, -17/9*t^4 + 136/9*t^3 + 493/9*t^2 - 136*t - 340, -17/9*t^4 - 136/9*t^3 + 493/9*t^2 + 136*t - 340, -3*t^4 + 39*t^3 - 78*t^2 - 156*t + 360, -3*t^4 - 39*t^3 - 78*t^2 + 156*t + 360, -10*t^4 + 130*t^3 - 260*t^2 - 520*t + 1200, -10*t^4 - 130*t^3 - 260*t^2 + 520*t + 1200, 17*t^4 + 119*t^3 - 578*t^2 - 476*t + 2040, 17*t^4 - 119*t^3 - 578*t^2 + 476*t + 2040, -85/4*t^4 + 255*t^3 - 935/4*t^2 - 2295*t + 3825, -85/4*t^4 - 255*t^3 - 935/4*t^2 + 2295*t + 3825, -51*t^4 + 255*t^3 + 4794*t^2 - 25500*t + 30600, -51*t^4 - 255*t^3 + 4794*t^2 + 25500*t + 30600];
