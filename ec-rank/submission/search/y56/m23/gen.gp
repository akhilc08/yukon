\\ generic-rank probe: rank of the subgroup generated by the construction's own points (a_i, +-q(a_i)),
\\ mapped to the Weierstrass model as in mestre-own/mestre.gp mesPts, measured by the height matrix.
mesMap(a,S)={my(qr=mesqr(a),Q=qr[1],r=qr[2],x0=a[1],y0=subst(Q,'x,x0));
 my(R=subst(r,'x,'x+x0)); my(A=polcoef(R,4),B=polcoef(R,3),C=polcoef(R,2),D=polcoef(R,1),q=y0);
 my(a1=D/q,a2=C-D^2/(4*q^2),a3=2*q*B,a4=-4*q^2*A,a6=a2*a4); my(E=ellinit([a1,a2,a3,a4,a6])); my(P=List());
 foreach(S,pt, my(u=pt[1]-x0,v=pt[2]); if(u==0,next);
   my(X=(2*q*(v+q)+D*u)/u^2, Y=(4*q^2*(v+q)+2*q*(D*u+C*u^2)-D^2*u^2/(2*q))/u^3);
   if(ellisoncurve(E,[X,Y]), listput(P,[X,Y])));
 my(w,M=ellinit(ellminimalmodel(E,&w))); [M, apply(z->ellchangepoint(z,w),Vec(P))]};
conrank(a)={my(Q=mesqr(a)[1]); my(S=concat(vector(#a,i,[a[i],subst(Q,'x,a[i])]),vector(#a,i,[a[i],-subst(Q,'x,a[i])])));
 my(F=mesMap(a,S),M=F[1],P=F[2]); if(#P==0,return([0,Hn(M)])); my(G=ellheightmatrix(M,P)); my(ev=qfjacobi(G)[1]);
 [#select(z->z>1e-15*vecmax(ev),ev), Hn(M)]};
